# Ejemplo de variables de entorno para desarrollo / ejecución local.
# Copia este archivo a `.env` y rellena los valores. NUNCA subas tu `.env`.

# Token de GitHub para leer el PR y publicar comentarios.
GITHUB_TOKEN=

# Clave de API de OpenAI para evaluar tests tautológicos (opcional).
OPENAI_API_KEY=

# Si es 'true', la Action falla también ante hallazgos leves.
FAIL_ON_WARNING=false
